{
  "name": "dsh-system-notify",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Shows a system notification when a turn finishes and when the agent needs your answer or approval.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "author": {
    "name": "LI",
    "url": "https://github.com/LXD-8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LXD-8/dsh-system-notify.git"
  }
}
